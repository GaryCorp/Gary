# Create your .env with: bash setup.sh
# It copies this file and replaces every "generate_by_setup_sh" value with a
# freshly generated secret, and sets HOST_UID/HOST_GID/AUDIO_GID for your user.
# Never commit .env; it holds your API key and encryption secrets.

# ------------------------------------------------------------
# Required — replace with your own key from platform.openai.com
# ------------------------------------------------------------

OPENAI_API_KEY=sk-replace_me_with_your_openai_api_key

OPENAI_ADMIN_KEY=replace_me
# ------------------------------------------------------------
# Generated by setup.sh (leave as-is here)
# ------------------------------------------------------------

# Signs the web UI session cookie.
SESSION_SECRET=generate_by_setup_sh
# Encrypts data/token_store.enc. Changing it means signing in to Google again.
TOKEN_ENCRYPTION_KEY=generate_by_setup_sh
# Encrypts Catherine's debit card details (a separate key from the Google tokens).
CARD_ENCRYPTION_KEY=generate_by_setup_sh
# Shared secret between the voice and backend containers.
VOICE_BRIDGE_TOKEN=generate_by_setup_sh

# Your user and group IDs (id -u / id -g); setup.sh sets them automatically.
HOST_UID=1000
HOST_GID=1000
# Host audio group ID. Not used since audio moved to the PipeWire socket.
AUDIO_GID=29

# ------------------------------------------------------------
# OpenAI Realtime
# ------------------------------------------------------------

# Voice conversations. Must be a Realtime model (gpt-realtime-*), for example
# gpt-realtime-2.1 or the cheaper gpt-realtime-2.1-mini. Only used when
# VOICE_MODE=realtime.
OPENAI_REALTIME_MODEL=gpt-realtime-2.1

# How a spoken turn is handled.
#   transcribe - the local wake word fires, the utterance is transcribed by
#                VOICE_TRANSCRIBE_MODEL, and the words go to VOICE_TEXT_MODEL.
#                Cheaper: no audio tokens for the whole conversation.
#   realtime   - one OpenAI Realtime session does everything.
VOICE_MODE=transcribe

# The transcription model, billed per minute of audio. No default: set it and
# give it a price, or the spend ceiling cannot hold.
#   docker compose exec backend python -m app.costs set-price <model> --per-minute X
VOICE_TRANSCRIBE_MODEL=

# The model that answers once the words exist. Empty = PLANNING_MODEL.
VOICE_TEXT_MODEL=

# How much quiet ends an utterance in transcribe mode, in seconds.
UTTERANCE_SILENCE_SECONDS=1.2
# Longest single utterance before it is sent anyway, in seconds.
MAX_UTTERANCE_SECONDS=30

# ------------------------------------------------------------
# Assistant behavior
# ------------------------------------------------------------

# IANA timezone name.
LOCAL_TIMEZONE=America/Chicago

# Maximum active window after wake-up, in seconds.
ACTIVE_SESSION_SECONDS=45

# After Gary finishes speaking, allow a short follow-up period, in seconds.
FOLLOWUP_GRACE_SECONDS=10

# How often the backend retries anything Gary decided to say but could not
# deliver, because nothing was listening or it was quiet hours, in seconds.
SPOKEN_DELIVERY_SECONDS=60

# A hard daily ceiling on what GaryCorp may spend on AI, in US dollars. When
# it is reached, everything that calls a model stops until local midnight,
# including voice. Raise it here and restart to lift the stop. 0 = no ceiling.
# It can only be enforced for models that have a price: check with
#   docker compose exec backend python -m app.costs report
MAX_DAILY_AI_SPEND_USD=10.00

# Which weekday Gary writes the weekly review on (0 = Monday, 4 = Friday).
WEEKLY_REVIEW_DAY=4

# The weekly video schedule. Every PRODUCTION_EPISODES_PER_SHOOT weeks one
# shoot films that many episodes, and one is published every week on
# PRODUCTION_PUBLISH_DAY. Gary plans each batch two weeks ahead: scripts,
# shoot, edit, thumbnail and publish, with deadlines worked back from the
# publish time, and puts the shoot and publish slots on your calendar.
# PRODUCTION_FIRST_SHOOT is the date of the first shoot (YYYY-MM-DD); leave
# it empty to turn the schedule off.
PRODUCTION_FIRST_SHOOT=
PRODUCTION_SERIES=Video
PRODUCTION_FIRST_EPISODE=1
PRODUCTION_EPISODES_PER_SHOOT=2
PRODUCTION_PUBLISH_DAY=fri
PRODUCTION_PUBLISH_TIME=17:00
PRODUCTION_SHOOT_TIME=10:00

# Refuse unattended work while any model GaryCorp is configured to use has no
# price: spending that cannot be measured cannot be capped. Talking to Gary
# still works, so he can tell you which model needs one. Check with
#   docker compose exec backend python -m app.costs models
# Set to false to keep running with unmeasurable spend.
REQUIRE_PRICED_MODELS=true

# How often Gary checks for new unread Primary inbox email and announces it,
# in minutes. 0 turns it off.
EMAIL_CHECK_INTERVAL_MINUTES=60

# Local hours (24-hour clock) when Gary won't announce new email, e.g. 22-7.
# Email that arrives then is announced at the first check afterwards.
# Leave empty to announce at any hour.
EMAIL_CHECK_QUIET_HOURS=22-7

# ------------------------------------------------------------
# Local Whisper / wake-word behavior
# ------------------------------------------------------------

# tiny, base, small (and .en variants). "base.en" balances accuracy and speed
# on a laptop CPU (about 1 s per wake check); "small.en" is more accurate but
# about 3 s per check, so use it only with a GPU. "tiny" is fastest.
# Downloaded during docker compose up --build; rebuild after changing it.
WHISPER_MODEL=base.en

# GPU only (docker compose -f compose.yaml -f compose.gpu.yaml).
# int8 suits small or older GPUs; float16 for Turing or newer.
WHISPER_COMPUTE_TYPE=int8

WAKE_WORD=gary

# Seconds of recent local audio Whisper examines for the wake word.
WAKE_WINDOW_SECONDS=2.2

# Seconds of audio from just before activation, so the command start is kept.
PRE_ROLL_SECONDS=1.8

# Seconds between local wake-word checks (higher uses less CPU). Keep it above
# the model's check time: ~0.6 s tiny, ~1.1 s base.en, ~3 s small.en on CPU.
WAKE_CHECK_INTERVAL_SECONDS=1.25

# ------------------------------------------------------------
# Chief of Staff database (data/gary.db)
# ------------------------------------------------------------

# Minutes between checks for due follow-ups and newly overdue tasks, which Gary
# announces (quiet hours apply). The daily backup runs on the same schedule.
# 0 turns the check off.
OPS_CHECK_INTERVAL_MINUTES=5

# Daily backups kept in data/backups.
GARY_BACKUP_KEEP=14

# Scheduled planning runs (local time). Each run makes one OpenAI call, may put
# up to PLANNING_MAX_ACTIONS ready tasks on the calendar within WORK_HOURS on
# PLANNING_WEEKDAYS (approval rules still apply), writes the daily summary note
# in Joplin, and speaks a short briefing. Leave PLANNING_TIMES empty to turn
# scheduled runs off.
PLANNING_TIMES=morning=08:00,midday=12:30,evening=17:30
PLANNING_WEEKDAYS=mon,tue,wed,thu,fri

# Optional: an OpenAI ADMIN key with the api.usage.read scope
# (platform.openai.com > Settings > Organization > Admin keys). With it,
# Catherine reports what OpenAI actually billed instead of estimating from
# the price table in data/model_prices.json. An ordinary API key cannot read
# usage and is reported as unavailable, never as zero.
OPENAI_ADMIN_KEY=

# Continuous operation. Between the scheduled cycles Gary checks every
# MANAGEMENT_TICK_MINUTES whether anything changed: a department report came
# back, a block passed unfinished, a follow-up fell due, an approval is about
# to expire. A check with nothing new costs nothing, because no model is
# called. 0 turns the loop off and leaves only the three daily cycles.
MANAGEMENT_TICK_MINUTES=15

# Hard ceiling on unattended management cycles in one local day.
MAX_MANAGEMENT_CYCLES_PER_DAY=24

# Days the loop runs. Empty follows PLANNING_WEEKDAYS; set all seven to keep
# the company running through a weekend.
MANAGEMENT_WEEKDAYS=
# Planning cycles. Any Responses API model with structured outputs, such as
# A Responses API model with structured outputs; not a Realtime model.
PLANNING_MODEL=gpt-5.6-luna
PLANNING_MAX_ACTIONS=5
WORK_HOURS=9-17

# Local times kept free on working days (meals, breaks), comma separated.
# Planning never schedules into them. Leave empty for none.
PROTECTED_TIMES=12:00-13:00

# What planning runs may see of unread Primary inbox email:
# snippets (sender, subject, short preview), subjects (sender and subject), off.
PLANNING_EMAIL=snippets

# The name Gary uses for you.
PRINCIPAL_NAME=Alex

# Gary's own Gmail address, separate from yours. Your Google account keeps the
# calendar and your inbox; this one is signed in on its own from the home page
# ("Gary's mailbox") and only this exact address is accepted. New emails Gary
# sends come from it. Leave empty for no separate mailbox. See docs/GOOGLE_OAUTH.md.
GARY_EMAIL_ADDRESS=

# ------------------------------------------------------------
# GaryCorp team (Susan, Dave, Linda, Catherine) - see docs/TEAM.md
# ------------------------------------------------------------

# Model for the specialists (CrewAI). Empty uses PLANNING_MODEL.
GARY_EMPLOYEE_MODEL=
# Model for Susan's and Catherine's read-only web search.
AGENT_WEB_SEARCH_MODEL=gpt-5.6-luna
MAX_AGENT_ITERATIONS=8
MAX_AGENT_EXECUTION_SECONDS=300
MAX_CONCURRENT_AGENT_RUNS=2
MAX_ASSIGNMENTS_PER_GARY_PLAN=6
MAX_ACTIVE_AGENT_ASSIGNMENTS=6

# Hard caps on Catherine's debit card purchase requests, in US dollars. Every
# purchase also needs your approval on the approvals web page.
CFO_PER_PURCHASE_LIMIT_USD=50
CFO_MONTHLY_LIMIT_USD=200

# ------------------------------------------------------------
# Engineering tickets (private GitHub repository and Project)
# ------------------------------------------------------------

# Fine-grained token with ONLY: repository Metadata read, Issues write, and
# organization Projects write. It must not have Contents, Actions,
# Administration, Workflows, or Secrets access: Gary never changes code.
# Leave empty to run without the engineering integration.
GITHUB_TOKEN=

# The private repository engineering issues are created in.
GITHUB_OWNER=
GITHUB_REPOSITORY=

# The private "GaryCorp Engineering" Project number (from its URL), and the
# GitHub username engineering issues are assigned to.
GITHUB_PROJECT_NUMBER=
GITHUB_ENGINEER_USERNAME=

# How often GitHub state is pulled into SQLite. Only unfinished tickets are
# checked, so a quiet board costs no API calls. 0 turns the periodic sync off.
GITHUB_SYNC_INTERVAL_MINUTES=5

# Lauren's EASE ethics service (the ease-api container). Empty EASE_API_URL
# means Lauren applies the framework herself without the service.
EASE_API_URL=http://ease-api:8000
# Must match the ease-api API_KEY; leave both empty for no key.
EASE_API_KEY=
# EASE's own model. Defaults to OpenAI with OPENAI_API_KEY.
# EASE_LLM_PROVIDER=openai
# EASE_LLM_API_KEY=
# EASE_LLM_MODEL=gpt-5.6-luna

# ------------------------------------------------------------
# Joplin notes
# ------------------------------------------------------------

# Joplin desktop > Tools > Options > Web Clipper: enable the service and paste
# the authorization token here. Leave empty to turn notes off.
JOPLIN_TOKEN=

# Top-level notebook Gary writes to; created if missing. Gary can only create
# notes in it and in notebooks inside it.
JOPLIN_NOTEBOOK=Gary

# ------------------------------------------------------------
# Docker network
# ------------------------------------------------------------

# Subnet for the network between the voice and backend containers. With a VPN
# such as NordVPN, allowlist it: nordvpn allowlist add subnet 172.30.99.0/24
# Change it only if it overlaps another network; run docker compose down after.
ASSISTANT_SUBNET=172.30.99.0/24
# The host's address on that network, where joplin-proxy listens. Must be
# inside ASSISTANT_SUBNET.
ASSISTANT_GATEWAY=172.30.99.1

# ------------------------------------------------------------
# Audio device
# ------------------------------------------------------------

# "default" uses the host's PipeWire/PulseAudio server.
# May also be a PortAudio device index such as 3 (see: make audio-devices).
AUDIO_DEVICE=default

# ------------------------------------------------------------
# Gary's voice (local Piper TTS)
# ------------------------------------------------------------

# Any voice from huggingface.co/rhasspy/piper-voices, e.g. en_US-lessac-medium.
# Downloaded at build time; rebuild the voice image after changing it.
PIPER_VOICE=en_US-ryan-medium

# Speech speed: higher is slower (1.15), lower is faster (0.9).
PIPER_LENGTH_SCALE=1.0

JOPLIN_TOKEN=

PLANNING_MODEL=gpt-5.6-luna
CARD_ENCRYPTION_KEY=

GITHUB_TOKEN=
GITHUB_OWNER=    # org or user owning the PRIVATE repo
GITHUB_REPOSITORY=       # the private repo
GITHUB_PROJECT_NUMBER=   # the private Project's number, from its URL
GITHUB_ENGINEER_USERNAME=   # your GitHub username